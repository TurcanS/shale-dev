#!/bin/sh
# Raise Lenovo's firmware power limits (lenovo-wmi-other) to the highest values the firmware itself allows.
# Installed root-owned by scripts/install-power-max.py and run only through shale-power-max.service. It takes no input:
# each limit gets its own max_value, temperature limits are left alone, and it does nothing on battery.
# Choosing any other power mode (Shale, powerprofilesctl, Fn+Q) puts the firmware's own limits back.
set -u
ATTR=/sys/class/firmware-attributes/lenovo-wmi-other-0/attributes
PROFILE=/sys/firmware/acpi/platform_profile

ac=0
for online in /sys/class/power_supply/A*/online; do
    [ -r "$online" ] && [ "$(cat "$online")" = 1 ] && ac=1
done
[ "$ac" = 1 ] || { echo "Plug in the charger first." >&2; exit 2; }
[ -d "$ATTR" ] && grep -qw custom "$PROFILE"_choices || { echo "No Lenovo custom power mode on this device." >&2; exit 3; }

echo custom > "$PROFILE" || exit 1
for name in ppt_pl1_spl ppt_pl2_sppt ppt_pl3_fppt ppt_cpu_cl gpu_nv_ctgp; do
    [ -r "$ATTR/$name/max_value" ] || continue
    cat "$ATTR/$name/max_value" > "$ATTR/$name/current_value" || echo "Could not raise $name." >&2
done
exit 0
